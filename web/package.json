{
  "name": "antcdp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts:prepare": "node ../scripts/prepare-fonts.mjs",
    "predev": "npm run fonts:prepare",
    "dev": "vite",
    "prebuild": "npm run fonts:prepare",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@date-fns/tz": "1.5.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "lucide-react": "1.66.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "eslint@10.14.0": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.1"
    }
  }
}

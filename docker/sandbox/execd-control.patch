+package runtime
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+)
+
+// Credentials must be absent even with hardening disabled. Filtering the
+// final merge also prevents request or binding overrides from reintroducing
+// a control-plane token into trusted helpers or ordinary workload processes.
+func TestPrepareCommandStripsControlCredentials(t *testing.T) {
+	t.Setenv("EXECD_ACCESS_TOKEN", "private-fixture-control-token")
+	t.Setenv("ANTCDP_TEST_ORDINARY_BASE", "base-kept")
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal("test executable unavailable")
+	}
+	for _, override := range []bool{false, true} {
+		name := "base_environment"
+		envs := map[string]string{"ANTCDP_TEST_ORDINARY_OVERRIDE": "override-kept"}
+		if override {
+			name = "request_override"
+			envs["EXECD_ACCESS_TOKEN"] = "private-fixture-override-token"
+		}
+		t.Run(name, func(t *testing.T) {
+			cmd, err := prepareCommand(context.Background(), &ExecuteCodeRequest{Argv: []string{executable}, Cwd: t.TempDir(), Envs: envs})
+			if err != nil {
+				t.Fatal("command preparation failed")
+			}
+			base, extra := false, false
+			for _, value := range cmd.Env {
+				key, data, ok := strings.Cut(value, "=")
+				if !ok {
+					continue
+				}
+				if strings.EqualFold(key, "EXECD_ACCESS_TOKEN") {
+					t.Fatal("control credential escaped final environment filter")
+				}
+				if key == "ANTCDP_TEST_ORDINARY_BASE" && data == "base-kept" {
+					base = true
+				}
+				if key == "ANTCDP_TEST_ORDINARY_OVERRIDE" && data == "override-kept" {
+					extra = true
+				}
+			}
+			if !base || !extra {
+				t.Fatal("ordinary process environment was lost")
+			}
+		})
+	}
+}

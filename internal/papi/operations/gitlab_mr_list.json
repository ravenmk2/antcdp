{
  "api_code": "gitlab.mr.list",
  "title": "列出 GitLab 合并请求",
  "summary": "按状态、分支或关键字查询单个 GitLab 项目中的合并请求。",
  "description": "Use project_repo_id returned by git_repo.list. Only merge requests whose source and target are in this GitLab project are supported. The default is all states, page 1 and page_size 20. Continue when next_page is set, even if items is empty after filtering fork MRs.",
  "effect": "read",
  "input_schema": {
    "type": "object",
    "properties": {
      "project_repo_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "state": {
        "type": "string",
        "enum": [
          "all",
          "opened",
          "closed",
          "locked",
          "merged"
        ]
      },
      "source_branch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "target_branch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "search": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "project_repo_id"
    ],
    "additionalProperties": false
  },
  "example_args": {
    "project_repo_id": "17",
    "state": "opened"
  },
  "result_description": "items contains MR summaries. page, page_size and nullable next_page reflect GitLab pagination."
}
